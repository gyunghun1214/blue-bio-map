{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blue-bio-map",
  "compatibility_date": "2026-09-21",
  "observability": {
    "enabled": true
  },
  // Static site only: every file in dist/ is served as-is. No Worker script
  // (the guide chatbot answers only from its fixed FAQ; the Workers AI /api/ask route was removed 2026-10-15).
  "assets": {
    "directory": "dist"
  },
  // Explicit opt-in required by Workers Builds for non-production branches.
  "previews": {},
  // Public URL: https://blue-bio-map.blue-bio-map.workers.dev
  "workers_dev": true,
  "preview_urls": false
}
