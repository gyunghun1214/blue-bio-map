/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Loaded from index.html with ?v=<first 10 hex of sha256 of the LF-normalized file>: recompute it whenever the file changes
# (verification/test_client_outdated.mjs fails until it matches).
/app.js
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=31536000, immutable
/pilot.css
  Cache-Control: public, max-age=31536000, immutable
/theme.css
  Cache-Control: public, max-age=31536000, immutable
/live-data.js
  Cache-Control: public, max-age=31536000, immutable
/expedition.js
  Cache-Control: public, max-age=31536000, immutable
/expedition.css
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
